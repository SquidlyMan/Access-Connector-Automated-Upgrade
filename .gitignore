# Nothing that is secret, licensed or site-specific belongs in this repository.

# Site fleet files (keep only the example)
FleetDeploy/fleet.psd1
FleetDeploy/fleet.*.psd1
!FleetDeploy/fleet.example.psd1

# Site fleet spreadsheets and -Mode Discover drafts (keep only the examples)
FleetDeploy/*.csv
FleetDeploy/*.xlsx
FleetDeploy/*.xls
FleetDeploy/*.tsv
FleetDeploy/*.txt
FleetDeploy/*.ods
FleetDeploy/*.numbers
FleetDeploy/*.xlsm
FleetDeploy/*.xlsb
# spreadsheet lock files (they hold the user's and the computer's name)
.~lock.*#
~$*
!FleetDeploy/fleet.example.csv
!FleetDeploy/fleet.example.xlsx
# a fleet file -ImportFleet was writing when it stopped
*.importing

# Run output
FleetDeploy/FleetLogs/
*.log
logs/

# Vendor installers and patches (download them from Omnissa)
Installers/*
!Installers/README.md

# Tenant configuration files (hold a password hash and tenant details)
Configs/*
!Configs/README.md

# Certificates and keys
ChildCerts/*
!ChildCerts/README.md
TrustedCerts/*
!TrustedCerts/README.md
*.pfx
*.p12
*.key
*.keytab
*password*.txt

# Session handoff notes (name the site; local only)
HANDOFF*.md

# Backups and scratch copies
*.bak
*.bak-*
*.new
*.test.ps1

# Python's compile cache (tools/*.py)
__pycache__/

# OS noise
.DS_Store
Thumbs.db

# Local agent-coordination state (thrum)
.thrum/
